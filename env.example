<!-- MODAL AJOUT JOURNALISTE -->
<div class="modal-overlay" id="modal-add-j">
  <div class="modal">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px">
      <div class="modal-title" style="margin-bottom:0">Ajouter un journaliste</div>
      <span class="modal-close" onclick="closeModal('modal-add-j')">Fermer</span>
    </div>
    <div class="fgrid">
      <div><label class="flabel">Nom complet</label><input class="finp" id="aj-name" placeholder="Prenom Nom"></div>
      <div><label class="flabel">Media</label><input class="finp" id="aj-media" placeholder="Jeune Afrique"></div>
      <div><label class="flabel">Localisation</label><input class="finp" id="aj-loc" placeholder="Abidjan / Paris"></div>
      <div><label class="flabel">Email</label><input class="finp" id="aj-email" placeholder="contact@media.com" type="email"></div>
      <div><label class="flabel">Twitter / X</label><input class="finp" id="aj-tw" placeholder="@handle"></div>
      <div><label class="flabel">LinkedIn</label><input class="finp" id="aj-li" placeholder="URL LinkedIn"></div>
      <div class="s2"><label class="flabel">Beats (separes par virgule)</label><input class="finp" id="aj-beats" placeholder="Business CI, Finance, BRVM"></div>
      <div class="s2"><label class="flabel">Dernier article publie</label><input class="finp" id="aj-article" placeholder="Titre du dernier article connu"></div>
    </div>
    <div id="modal-error" class="error-msg" style="display:none"></div>
    <div class="modal-foot">
      <button class="sbtn" onclick="saveJournalist()">Ajouter</button>
      <button class="cancelbtn" onclick="closeModal('modal-add-j')">Annuler</button>
    </div>
  </div>
</div>

<script>
// URL du backend - sera remplace par l'URL Render apres deploiement
const BASE = window.location.origin;

function tick(){document.getElementById('synct').textContent=new Date().toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'})}
tick();setInterval(tick,30000);

// Navigation
function go(t){
  document.querySelectorAll('.ntab').forEach(x=>x.classList.remove('active'));
  document.querySelectorAll('.panel').forEach(x=>x.classList.remove('active'));
  t.classList.add('active');
  document.getElementById('panel-'+t.dataset.p).classList.add('active');
  const p=t.dataset.p;
  if(p==='bottin')loadJournalists();
  if(p==='clients')loadClients();
  if(p==='veille')loadVeille();
  if(p==='roi')roi();
}

// Temps relatif
function relTime(dateStr){
  const diff=(Date.now()-new Date(dateStr))/1000;
  if(diff<60)return 'a l\'instant';
  if(diff<3600)return Math.floor(diff/60)+' min';
  if(diff<86400)return Math.floor(diff/3600)+' h';
  return Math.floor(diff/86400)+' j';
}

// RADAR - RSS live
let allItems=[];
async function loadRadar(){
  try{
    const r=await fetch(BASE+'/api/radar');
    const d=await r.json();
    allItems=d.items||[];
    document.getElementById('s-tot').textContent=allItems.length;
    document.getElementById('s-src').textContent=(d.sources||10)+' sources';
    document.getElementById('radar-count').textContent=allItems.length;
    document.getElementById('source-count').textContent=(d.sources||10)+' sources actives';
    renderFeed('all');
  }catch(e){
    document.getElementById('feedlist').innerHTML='<div class="loading">Erreur de chargement RSS. Verifie que le serveur est actif.</div>';
  }
}

function renderFeed(cat){
  const list=document.getElementById('feedlist');
  const filtered=cat==='all'?allItems:allItems.filter(i=>(i.category||'').includes(cat)||(i.region==='afrique'&&cat==='afr'));
  if(!filtered.length){list.innerHTML='<div class="loading">Aucun article pour ce filtre.</div>';return}
  list.innerHTML=filtered.slice(0,30).map((item,idx)=>`
    <a href="${item.link||'#'}" target="_blank" rel="noopener" style="text-decoration:none;display:block">
    <div class="fi">
      <div class="fno">${String(idx+1).padStart(2,'0')}</div>
      <div>
        <div class="fsrc">${item.source||''}</div>
        <div class="ftit">${item.title||''}</div>
        <div class="ftags">
          ${(item.category||'').includes('pr')?'<span class="ftag">PR</span>':''}
          ${(item.category||'').includes('crea')?'<span class="ftag o">Pub creative</span>':''}
          ${(item.category||'').includes('expe')?'<span class="ftag g">Experimental</span>':''}
          ${(item.region==='afrique')?'<span class="ftag g">Afrique</span>':''}
          ${(item.region==='europe')?'<span class="ftag">Europe</span>':''}
        </div>
      </div>
      <div class="ftime">${relTime(item.date)}</div>
    </div></a>`).join('');
}

function filterFeed(btn,cat){
  document.querySelectorAll('.fpills .fp').forEach(p=>p.classList.remove('active'));
  btn.classList.add('active');
  renderFeed(cat);
}

// MEDIATEK tabs
function mktab(t,k){
  document.querySelectorAll('.itab').forEach(x=>x.classList.remove('active'));
  t.classList.add('active');
  document.querySelectorAll('.mkitem').forEach(r=>{r.style.display=r.dataset.mk===k?'':'none'});
}

// BOTTIN - live depuis API
async function loadJournalists(){
  const search=document.getElementById('jsearch')?.value||'';
  try{
    const r=await fetch(BASE+'/api/journalists'+(search?'?search='+encodeURIComponent(search):''));
    const data=await r.json();
    document.getElementById('j-count').textContent=data.length;
    document.getElementById('jlist').innerHTML=data.length?data.map(j=>`
      <div class="jitem">
        <div>
          <div class="jn">${j.name}</div>
          <div class="jm">${j.media} / ${j.location||''}</div>
          <div class="jbeats">${(j.beats||[]).map(b=>`<span class="jb">${b}</span>`).join('')}</div>
          ${j.lastArticle?`<div style="font-size:11px;color:var(--muted);margin-top:6px;font-style:italic">"${j.lastArticle}"</div>`:''}
        </div>
        <div style="display:flex;flex-direction:column;gap:8px">
          <button class="jpbtn" onclick="topitch('${j.name}','${j.media}','${(j.beats||[]).join(', ')}')">Pitch AI</button>
          <button class="jpbtn" style="border-color:var(--line);color:var(--muted)" onclick="deleteJ(${j.id},'${j.name}')">Supprimer</button>
        </div>
      </div>`).join(''):'<div style="font-family:var(--mono);font-size:10px;color:var(--muted);padding:20px 0">Aucun contact.</div>';
  }catch(e){
    document.getElementById('jlist').innerHTML='<div class="loading">Erreur de chargement.</div>';
  }
}

async function deleteJ(id,name){
  if(!confirm('Supprimer '+name+' ?'))return;
  await fetch(BASE+'/api/journalists/'+id,{method:'DELETE'});
  loadJournalists();
}

function openAddJ(){document.getElementById('modal-add-j').classList.add('open')}
function closeModal(id){document.getElementById(id).classList.remove('open')}

async function saveJournalist(){
  const name=document.getElementById('aj-name').value.trim();
  const media=document.getElementById('aj-media').value.trim();
  if(!name||!media){
    const err=document.getElementById('modal-error');
    err.textContent='Nom et media obligatoires.';err.style.display='block';return;
  }
  const beats=document.getElementById('aj-beats').value.split(',').map(b=>b.trim()).filter(Boolean);
  await fetch(BASE+'/api/journalists',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({
      name,media,
      location:document.getElementById('aj-loc').value,
      email:document.getElementById('aj-email').value,
      twitter:document.getElementById('aj-tw').value,
      linkedin:document.getElementById('aj-li').value,
      beats,
      lastArticle:document.getElementById('aj-article').value
    })
  });
  closeModal('modal-add-j');
  loadJournalists();
}

// CLIENTS
async function loadClients(){
  try{
    const r=await fetch(BASE+'/api/clients');
    const data=await r.json();
    document.getElementById('cl-count').textContent=data.filter(c=>c.status==='actif').length;
    document.getElementById('client-list').innerHTML=data.map(c=>`
      <div class="clientcard">
        <div class="cc-head">
          <div>
            <div class="cc-name">${c.name}</div>
            <div class="cc-sector">${c.sector}</div>
          </div>
          <span class="cc-status">${c.status}</span>
        </div>
        <div class="cc-campaign">Campagne : ${c.campaign} / Contact : ${c.contact}</div>
        <div style="font-size:11px;color:var(--muted);font-weight:300;margin-bottom:10px">${c.description}</div>
        <div style="font-family:var(--mono);font-size:9px;color:var(--muted);letter-spacing:.1em;text-transform:uppercase;margin-bottom:8px">Axes de communication</div>
        <div class="cc-axes">${(c.axes||[]).map(a=>`<div class="cc-axe">${a}</div>`).join('')}</div>
        <div style="margin-top:12px;display:flex;gap:6px;flex-wrap:wrap">${(c.mediaTargets||[]).map(m=>`<span class="ftag">${m}</span>`).join('')}</div>
      </div>`).join('');
  }catch(e){
    document.getElementById('client-list').innerHTML='<div class="loading">Erreur de chargement.</div>';
  }
}

// VEILLE live
async function loadVeille(){
  try{
    const r=await fetch(BASE+'/api/veille');
    const data=await r.json();
    const tot=data.reduce((s,c)=>s+c.count,0);
    document.getElementById('v-tot').textContent=tot;
    document.getElementById('veille-content').innerHTML=`<div class="two">`+
      `<div>`+data.map(c=>`
        <div class="vc">
          <div class="vcn">${c.client}</div>
          <div class="vcs">${c.count} mention${c.count>1?'s':''} detectee${c.count>1?'s':''} dans les flux RSS</div>
          ${c.mentions.length?`
          <div class="btrack"><div class="bpos" style="width:70%"></div><div class="bneu" style="width:20%"></div><div class="bneg" style="width:10%"></div></div>
          <div class="blabs"><span style="color:var(--green)">Positif majoritaire</span><span>Neutre</span><span style="color:var(--red)">Negatif</span></div>
          `:`<div style="font-family:var(--mono);font-size:9px;color:var(--muted)">Aucune mention detectee dans les flux RSS actuels.</div>`}
        </div>`).join('')+`</div>`+
      `<div><div class="rl"><span class="rlt">Mentions recentes</span></div>`+
      data.flatMap(c=>c.mentions).slice(0,6).map(m=>`
        <div class="fi" style="grid-template-columns:1fr 60px;cursor:pointer" onclick="window.open('${m.link||'#'}','_blank')">
          <div><div class="fsrc">${m.source}</div><div class="ftit" style="font-size:14px">${m.title}</div><div class="ftags"><span class="ftag">${m.client}</span></div></div>
          <div class="ftime">${relTime(m.date)}</div>
        </div>`).join('')+
      `</div></div>`;
  }catch(e){
    document.getElementById('veille-content').innerHTML='<div class="loading">Erreur de chargement.</div>';
  }
}

// PITCH - via backend securise
function topitch(j,m,b){
  document.getElementById('pj').value=j;
  document.getElementById('pm').value=m;
  document.getElementById('pb2').value=b;
  document.querySelectorAll('.ntab').forEach(x=>x.classList.remove('active'));
  document.querySelectorAll('.panel').forEach(x=>x.classList.remove('active'));
  document.querySelector('[data-p="pitch"]').classList.add('active');
  document.getElementById('panel-pitch').classList.add('active');
}

async function genPitch(){
  const j=document.getElementById('pj').value.trim();
  const m=document.getElementById('pm').value.trim();
  const b=document.getElementById('pb2').value.trim();
  const c=document.getElementById('pc').value.trim();
  const a=document.getElementById('pa').value;
  const l=document.getElementById('pl').value;
  const ctx=document.getElementById('pctx').value.trim();
  if(!j||!m||!c){alert('Remplis au minimum : journaliste, media et sujet client.');return}
  const al={scoop:'scoop et exclusivite',portrait:'portrait et interview CEO',analyse:'analyse de marche',tendance:'tendance sectorielle',impact:'impact social ou culturel',award:'prix ou distinction'};
  const btn=document.getElementById('genbtn');btn.disabled=true;btn.textContent='Generation...';
  const out=document.getElementById('pout');
  out.classList.remove('ph','loaded');out.textContent='Signal redige ton pitch...';
  const prompt=`Tu es expert en relations presse et brand communications specialise en Afrique et Europe.\n\nGenere un pitch email professionnel et personnalise :\nJournaliste : ${j}\nMedia : ${m}\nBeats : ${b}\nSujet : ${c}\nAngle : ${al[a]}\n${ctx?'Contexte : '+ctx:''}\n\nRegles : accroche personnalisee sur ce journaliste, sujet en deux ou trois phrases percutantes, un ou deux elements de preuve, valeur ajoutee exclusive pour ce media, call-to-action clair. Maximum 200 mots. Premiere ligne : OBJET : [objet].\n${l==='fr'?'Redige en francais. Aucun tiret cadratin. Aucun guillemet francais.':'Write in English. No em-dashes.'}\nGenere uniquement l'email, sans commentaire.`;
  try{
    const r=await fetch(BASE+'/api/claude',{
      method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({messages:[{role:'user',content:prompt}]})
    });
    const d=await r.json();
    const t=d.content?.[0]?.text||'Erreur.';
    out.textContent=t;out.classList.add('loaded');
    document.getElementById('ptip').textContent='Genere via backend Signal pour '+j+' / '+m;
    document.getElementById('copybtn').style.display='';
    document.getElementById('regenbtn').style.display='';
  }catch{out.textContent='Erreur de connexion au backend.'}
  btn.disabled=false;btn.textContent='Generer le pitch';
}

function cpPitch(){
  navigator.clipboard.writeText(document.getElementById('pout').textContent).then(()=>{
    const b=document.getElementById('copybtn');b.textContent='Copie';setTimeout(()=>b.textContent='Copier',1800);
  });
}

// ASSISTANT - via backend securise
const hist=[];
const SYSTEM=`Tu es Signal, assistant PR intelligence pour une Head of Press Relations et Brand Visibility basee a Abidjan. Tu connais ses clients : BBGCI (IPO BRVM), BOSS Cote d'Ivoire (pret-a-porter premium), MFP Mouvement Femmes et Paroles (campagne MGF), L'Agence X (agence 360). Marches africains (CI, Senegal, Nigeria, pan-Afrique) et europeens (France). Style : concis, expert, actionnable. Aucun tiret cadratin. Aucun guillemet francais. Reponds en francais.`;

async function sendAI(){
  const inp=document.getElementById('aiin');
  const msg=inp.value.trim();if(!msg)return;
  inp.value='';addMsg(msg,'u');hist.push({role:'user',content:msg});
  document.getElementById('aisnd').disabled=true;
  addMsg('...','t');
  try{
    const r=await fetch(BASE+'/api/claude',{
      method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({system:SYSTEM,messages:hist})
    });
    const d=await r.json();
    const rep=d.content?.[0]?.text||'Erreur.';
    removeThink();addMsg(rep,'a');hist.push({role:'assistant',content:rep});
  }catch{removeThink();addMsg('Erreur de connexion au backend.','a')}
  document.getElementById('aisnd').disabled=false;
}
function addMsg(t,type){
  const c=document.getElementById('aimsgs');
  const d=document.createElement('div');
  if(type==='u')d.className='aiu';
  else if(type==='a')d.className='aia';
  else{d.className='aith';d.id='aith'}
  d.textContent=t;c.appendChild(d);c.scrollTop=c.scrollHeight;
}
function removeThink(){const e=document.getElementById('aith');if(e)e.remove()}
function aikey(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendAI()}}
function askAI(q){
  document.querySelectorAll('.ntab').forEach(x=>x.classList.remove('active'));
  document.querySelectorAll('.panel').forEach(x=>x.classList.remove('active'));
  document.querySelector('[data-p="assistant"]').classList.add('active');
  document.getElementById('panel-assistant').classList.add('active');
  document.getElementById('aiin').value=q;sendAI();
}

// ROI
function fmt(n,m){return m==='fr'?new Intl.NumberFormat('fr-FR',{style:'currency',currency:'EUR',maximumFractionDigits:0}).format(n):new Intl.NumberFormat('fr-FR').format(Math.round(n))+' FCFA'}
function roi(){
  const a=parseInt(document.getElementById('ra').value)||0;
  const aud=parseInt(document.getElementById('raud').value)||0;
  const b=parseInt(document.getElementById('rb').value)||0;
  const m=document.getElementById('rm').value;
  const mul=m==='fr'?.02:10;
  const press=a*aud*mul;const tv=b*(m==='fr'?8000:4000000);
  const tot=press+tv;const esp=tot*3.2;
  document.getElementById('rcur').textContent=m==='fr'?'EUR':'FCFA';
  document.getElementById('rtot').textContent=tot>0?fmt(tot,m):'--';
  document.getElementById('rpress').textContent=press>0?fmt(press,m):'--';
  document.getElementById('rtv').textContent=tv>0?fmt(tv,m):'--';
  document.getElementById('resp').textContent=esp>0?fmt(esp,m):'--';
  document.getElementById('rratio').textContent=tot>0?(tot/(m==='fr'?15000:8000000)).toFixed(1)+'x':'--';
}

// Init
loadRadar();
setInterval(loadRadar, 5*60*1000); // refresh RSS toutes les 5 min
roi();
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Signal</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Mono:ital,wght@0,300;0,400;1,300&family=Instrument+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --white:#FAFAF8;--black:#0E0E0D;--ink:#1A1A18;--muted:#8A8A84;
  --faint:#E8E8E4;--faint2:#F4F4F0;--line:#DDDDD8;
  --red:#C8352A;--red-pale:#F9F0EF;
  --gold:#B8933A;--gold-pale:#FAF5EC;
  --green:#2E6E52;--green-pale:#EEF5F1;
  --serif:'Cormorant Garamond',Georgia,serif;
  --mono:'DM Mono',monospace;
  --sans:'Instrument Sans',sans-serif;
}
html,body{height:100%;background:var(--white);color:var(--ink);font-family:var(--sans);overflow:hidden}
#masthead{position:fixed;top:0;left:0;right:0;height:52px;background:var(--white);border-bottom:1px solid var(--line);display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0 36px;z-index:200}
.ml{display:flex;align-items:center;gap:18px}
.mr{display:flex;align-items:center;gap:18px;justify-content:flex-end}
.wordmark{font-family:var(--serif);font-size:22px;font-weight:400;letter-spacing:0.28em;color:var(--black);text-transform:uppercase}
.livew{display:flex;align-items:center;gap:6px;font-family:var(--mono);font-size:9px;letter-spacing:0.14em;color:var(--muted);text-transform:uppercase}
.ldot{width:5px;height:5px;border-radius:50%;background:var(--red);animation:bl 2.5s ease infinite}
@keyframes bl{0%,100%{opacity:1}50%{opacity:.2}}
.ts{font-family:var(--mono);font-size:9px;letter-spacing:0.07em;color:var(--muted)}
#navbar{position:fixed;top:52px;left:0;right:0;height:40px;background:var(--white);border-bottom:1px solid var(--line);display:flex;align-items:stretch;padding:0 20px;z-index:190;overflow-x:auto}
#navbar::-webkit-scrollbar{display:none}
.ntab{font-family:var(--mono);font-size:9px;letter-spacing:0.12em;text-transform:uppercase;color:var(--muted);padding:0 16px;display:flex;align-items:center;gap:7px;cursor:pointer;border-bottom:1.5px solid transparent;margin-bottom:-1px;transition:color .15s,border-color .15s;white-space:nowrap}
.ntab:hover{color:var(--ink)}.ntab.active{color:var(--black);border-bottom-color:var(--black)}
.nb{font-family:var(--mono);font-size:8px;background:var(--red);color:#fff;padding:2px 5px;border-radius:1px}
.nb.g{background:var(--green)}.nb.o{background:var(--gold);color:var(--black)}
#content{position:fixed;top:92px;left:0;right:0;bottom:0;overflow-y:auto;background:var(--white)}
#content::-webkit-scrollbar{width:3px}
#content::-webkit-scrollbar-thumb{background:var(--line)}
.panel{display:none;animation:fi .22s ease}.panel.active{display:block}
@keyframes fi{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}
.phead{padding:48px 64px 34px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:1fr auto;align-items:end;gap:48px}
.pkick{font-family:var(--mono);font-size:9px;letter-spacing:0.18em;text-transform:uppercase;color:var(--muted);margin-bottom:10px}
.ptit{font-family:var(--serif);font-size:52px;font-weight:300;line-height:1.03;color:var(--black);letter-spacing:-.01em}
.ptit em{font-style:italic}
.pdesc{font-size:12px;color:var(--muted);line-height:1.75;max-width:400px;font-weight:300;margin-top:10px}
.hs{display:flex;gap:40px;border-left:1px solid var(--line);padding-left:40px}
.hsn{font-family:var(--serif);font-size:42px;font-weight:300;color:var(--black);line-height:1}
.hsl{font-family:var(--mono);font-size:9px;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);margin-top:5px}
.hsd{font-family:var(--mono);font-size:9px;color:var(--green);margin-top:3px}
.pb{padding:38px 64px 70px}
.fpills{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:30px}
.fp{font-family:var(--mono);font-size:9px;letter-spacing:0.1em;text-transform:uppercase;padding:5px 14px;border:1px solid var(--line);color:var(--muted);cursor:pointer;transition:all .14s;background:transparent;border-radius:1px}
.fp:hover{border-color:var(--muted);color:var(--ink)}
.fp.active{background:var(--black);border-color:var(--black);color:var(--white)}
.fp.r.active{background:var(--red);border-color:var(--red);color:#fff}
.fp.g.active{background:var(--green);border-color:var(--green);color:#fff}
.feed{display:flex;flex-direction:column}
.fi{display:grid;grid-template-columns:68px 1fr 58px;gap:18px;align-items:start;padding:20px 0;border-bottom:1px solid var(--line);cursor:pointer;transition:padding .12s,background .12s}
.fi:hover{background:var(--faint2);margin:0 -64px;padding-left:64px;padding-right:64px}
.fi:last-child{border-bottom:none}
.fno{font-family:var(--serif);font-size:28px;font-weight:300;color:var(--faint);line-height:1.1;transition:color .2s}
.fi:hover .fno{color:var(--line)}
.fsrc{font-family:var(--mono);font-size:9px;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);margin-bottom:5px}
.ftit{font-family:var(--serif);font-size:17px;font-weight:400;color:var(--black);line-height:1.45;margin-bottom:8px}
.ftags{display:flex;gap:5px;flex-wrap:wrap}
.ftag{font-family:var(--mono);font-size:8px;letter-spacing:0.08em;text-transform:uppercase;padding:3px 7px;border:1px solid var(--line);color:var(--muted);border-radius:1px}
.ftag.r{border-color:rgba(200,53,42,.25);color:var(--red);background:var(--red-pale)}
.ftag.g{border-color:rgba(46,110,82,.25);color:var(--green);background:var(--green-pale)}
.ftag.o{border-color:rgba(184,147,58,.25);color:var(--gold);background:var(--gold-pale)}
.ftime{font-family:var(--mono);font-size:9px;color:var(--muted);text-align:right;padding-top:3px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:56px}
.rl{display:flex;align-items:center;gap:14px;margin:26px 0 18px}
.rlt{font-family:var(--mono);font-size:9px;letter-spacing:0.16em;text-transform:uppercase;color:var(--muted);white-space:nowrap}
.rl::after{content:'';flex:1;height:1px;background:var(--line)}
.itabs{display:flex;border-bottom:1px solid var(--line);margin-bottom:28px}
.itab{font-family:var(--mono);font-size:9px;letter-spacing:0.12em;text-transform:uppercase;padding:10px 18px;cursor:pointer;color:var(--muted);border-bottom:1.5px solid transparent;margin-bottom:-1px;transition:all .15s}
.itab:hover{color:var(--ink)}.itab.active{color:var(--black);border-bottom-color:var(--black)}
.mkitem{display:grid;grid-template-columns:40px 1fr auto;gap:16px;align-items:center;padding:16px 0;border-bottom:1px solid var(--line)}
.mkitem:last-child{border-bottom:none}
.mkini{width:34px;height:34px;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:9px;color:var(--muted);border-radius:1px}
.mkn{font-family:var(--serif);font-size:15px;font-weight:400;color:var(--black);margin-bottom:2px}
.mkm{font-family:var(--mono);font-size:9px;color:var(--muted);letter-spacing:.03em}
.mkact{display:flex;align-items:center;gap:9px}
.mksig{width:5px;height:5px;border-radius:50%}
.mksig.g{background:var(--green)}.mksig.o{background:var(--gold)}
.mkbtn{font-family:var(--mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase;padding:5px 12px;border:1px solid var(--line);color:var(--muted);background:transparent;cursor:pointer;transition:all .14s;border-radius:1px}
.mkbtn:hover{border-color:var(--black);color:var(--black)}
.jitem{display:grid;grid-template-columns:1fr auto;align-items:center;gap:16px;padding:20px 0;border-bottom:1px solid var(--line);cursor:pointer}
.jitem:last-child{border-bottom:none}
.jitem:hover .jn{text-decoration:underline;text-underline-offset:3px}
.jn{font-family:var(--serif);font-size:19px;font-weight:400;color:var(--black);margin-bottom:2px}
.jm{font-family:var(--mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:7px}
.jbeats{display:flex;gap:5px;flex-wrap:wrap}
.jb{font-family:var(--mono);font-size:8px;letter-spacing:.07em;text-transform:uppercase;padding:3px 7px;border:1px solid var(--line);color:var(--muted);border-radius:1px}
.jb.g{border-color:rgba(46,110,82,.25);color:var(--green);background:var(--green-pale)}
.jb.r{border-color:rgba(200,53,42,.25);color:var(--red);background:var(--red-pale)}
.jb.o{border-color:rgba(184,147,58,.25);color:var(--gold);background:var(--gold-pale)}
.jpbtn{font-family:var(--mono);font-size:9px;letter-spacing:.12em;text-transform:uppercase;padding:7px 16px;border:1px solid var(--black);color:var(--black);background:transparent;cursor:pointer;transition:all .17s;white-space:nowrap;border-radius:1px}
.jpbtn:hover{background:var(--black);color:var(--white)}
.jadd{font-family:var(--mono);font-size:9px;letter-spacing:.12em;text-transform:uppercase;padding:7px 16px;border:1px solid var(--line);color:var(--muted);background:transparent;cursor:pointer;transition:all .17s;border-radius:1px;margin-top:20px}
.jadd:hover{border-color:var(--green);color:var(--green)}
.flabel{font-family:var(--mono);font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);display:block;margin-bottom:8px}
.fgrid{display:grid;grid-template-columns:1fr 1fr;gap:16px 28px;margin-bottom:24px}
.fgrid .s2{grid-column:span 2}
.finp,.fsel,.ftxa{width:100%;background:transparent;border:none;border-bottom:1px solid var(--line);padding:8px 0;font-size:13px;color:var(--ink);font-family:var(--sans);font-weight:300;outline:none;transition:border-color .14s;appearance:none;-webkit-appearance:none;border-radius:0}
.finp:focus,.fsel:focus,.ftxa:focus{border-bottom-color:var(--black)}
.finp::placeholder,.ftxa::placeholder{color:var(--muted)}
.ftxa{resize:vertical;min-height:76px;line-height:1.6}
.gbtn{font-family:var(--mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;padding:12px 28px;border:1px solid var(--black);background:var(--black);color:var(--white);cursor:pointer;transition:all .2s;border-radius:1px}
.gbtn:hover{background:transparent;color:var(--black)}
.gbtn:disabled{opacity:.3;pointer-events:none}
.pout{border-left:2px solid var(--line);padding:24px 28px;font-family:var(--serif);font-size:16px;line-height:1.88;color:var(--ink);font-weight:300;white-space:pre-wrap;word-wrap:break-word;min-height:180px;transition:border-color .3s}
.pout.loaded{border-left-color:var(--black)}
.pout.ph{font-family:var(--mono);font-size:11px;color:var(--muted);font-style:normal;letter-spacing:.04em}
.cbtn{font-family:var(--mono);font-size:9px;letter-spacing:.12em;text-transform:uppercase;padding:7px 14px;border:1px solid var(--line);color:var(--muted);background:transparent;cursor:pointer;transition:all .14s;margin-top:12px;border-radius:1px}
.cbtn:hover{border-color:var(--black);color:var(--black)}
.intel-row{display:grid;grid-template-columns:100px 1fr;gap:24px;padding:22px 0;border-bottom:1px solid var(--line)}
.intel-row:last-child{border-bottom:none}
.itag{font-family:var(--mono);font-size:8px;letter-spacing:.1em;text-transform:uppercase;padding:4px 8px;border-radius:1px;width:fit-content}
.itag.r{border:1px solid rgba(200,53,42,.3);color:var(--red);background:var(--red-pale)}
.itag.o{border:1px solid rgba(184,147,58,.3);color:var(--gold);background:var(--gold-pale)}
.itag.g{border:1px solid rgba(46,110,82,.3);color:var(--green);background:var(--green-pale)}
.itime{font-family:var(--mono);font-size:9px;color:var(--muted);margin-top:7px}
.ititl{font-family:var(--serif);font-size:17px;font-weight:400;color:var(--black);margin-bottom:5px}
.ibody{font-size:12px;color:var(--muted);line-height:1.7;font-weight:300}
.caltab{width:100%;border-collapse:collapse}
.caltab tr{border-bottom:1px solid var(--line)}.caltab tr:last-child{border-bottom:none}
.caltab td{padding:13px 0;font-size:12px;vertical-align:top}
.caltab td:first-child{font-family:var(--serif);font-size:15px;font-weight:400;color:var(--black);width:60%}
.caltab td:last-child{font-family:var(--mono);font-size:10px;color:var(--red);letter-spacing:.05em;text-align:right}
.vc{padding:22px 0;border-bottom:1px solid var(--line)}.vc:last-child{border-bottom:none}
.vcn{font-family:var(--serif);font-size:18px;font-weight:300;color:var(--black);margin-bottom:3px}
.vcs{font-family:var(--mono);font-size:9px;color:var(--muted);margin-bottom:10px;letter-spacing:.04em}
.btrack{height:2px;background:var(--faint);display:flex;overflow:hidden;margin-bottom:5px}
.bpos{background:var(--green);height:2px}.bneu{background:var(--line);height:2px}.bneg{background:var(--red);height:2px}
.blabs{display:flex;justify-content:space-between;font-family:var(--mono);font-size:8px;color:var(--muted)}
.roiline{display:flex;align-items:baseline;justify-content:space-between;padding:14px 0;border-bottom:1px solid var(--line)}.roiline:last-child{border-bottom:none}
.roilab{font-size:12px;color:var(--muted);font-weight:300}
.roival{font-family:var(--serif);font-size:18px;font-weight:300;color:var(--black)}
.roihero{font-family:var(--serif);font-size:58px;font-weight:300;color:var(--black);line-height:1;margin:20px 0 7px;letter-spacing:-.02em}
.roicur{font-family:var(--mono);font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.aiwrap{border:1px solid var(--line);border-radius:1px;overflow:hidden}
.aihead{padding:12px 18px;border-bottom:1px solid var(--line);background:var(--faint2);display:flex;align-items:center;justify-content:space-between}
.aihl{font-family:var(--mono);font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);display:flex;align-items:center;gap:8px}
.aion{width:5px;height:5px;border-radius:50%;background:var(--green);animation:bl 2s infinite}
.aimsgs{min-height:220px;max-height:360px;overflow-y:auto;padding:22px 22px 10px;display:flex;flex-direction:column;gap:14px}
.aimsgs::-webkit-scrollbar{width:2px}.aimsgs::-webkit-scrollbar-thumb{background:var(--line)}
.aiu{align-self:flex-end;font-family:var(--mono);font-size:10px;letter-spacing:.04em;color:var(--muted);background:var(--faint2);border:1px solid var(--line);padding:10px 14px;border-radius:1px;max-width:80%;line-height:1.6}
.aia{align-self:flex-start;font-family:var(--serif);font-size:15px;font-weight:300;color:var(--ink);line-height:1.78;max-width:90%;padding:13px 16px;border-left:2px solid var(--line)}
.aith{font-family:var(--mono);font-size:9px;letter-spacing:.1em;color:var(--muted);text-transform:uppercase;animation:blink2 1.2s infinite}
@keyframes blink2{0%,100%{opacity:.3}50%{opacity:1}}
.airow{border-top:1px solid var(--line);padding:13px 18px;display:flex;gap:10px;align-items:flex-end;background:var(--white)}
.aiin{flex:1;background:transparent;border:none;font-family:var(--sans);font-size:13px;font-weight:300;color:var(--ink);outline:none;resize:none;line-height:1.6;max-height:90px;overflow-y:auto}
.aiin::placeholder{color:var(--muted)}
.aisnd{font-family:var(--mono);font-size:9px;letter-spacing:.14em;text-transform:uppercase;padding:8px 14px;border:1px solid var(--black);background:var(--black);color:var(--white);cursor:pointer;transition:all .17s;flex-shrink:0;border-radius:1px}
.aisnd:hover{background:transparent;color:var(--black)}.aisnd:disabled{opacity:.3;pointer-events:none}
.qq{font-size:12px;font-weight:300;color:var(--muted);padding:12px 0;border-bottom:1px solid var(--line);cursor:pointer;transition:color .14s;display:flex;align-items:center;justify-content:space-between;gap:14px}
.qq:last-child{border-bottom:none}.qq:hover{color:var(--black)}
.qqa{font-family:var(--mono);font-size:10px;color:var(--line);transition:color .14s}.qq:hover .qqa{color:var(--muted)}
.mcard{display:grid;grid-template-columns:42px 1fr;gap:24px;align-items:start;padding:28px 0;border-bottom:1px solid var(--line)}.mcard:last-child{border-bottom:none}
.mcn{font-family:var(--serif);font-size:36px;font-weight:300;color:var(--faint);line-height:1}
.mctit{font-family:var(--serif);font-size:18px;font-weight:400;color:var(--black);margin-bottom:5px}
.mcdesc{font-size:12px;color:var(--muted);line-height:1.72;font-weight:300;max-width:560px}
.mcst{display:inline-block;font-family:var(--mono);font-size:8px;letter-spacing:.1em;text-transform:uppercase;padding:3px 8px;border-radius:1px;margin-top:10px;border:1px solid var(--line);color:var(--muted)}
.mcst.nx{border-color:rgba(200,53,42,.3);color:var(--red);background:var(--red-pale)}
.mcst.v2{border-color:rgba(46,110,82,.3);color:var(--green);background:var(--green-pale)}
.sbar{display:flex;align-items:center;gap:12px;border-bottom:1px solid var(--line);padding:11px 0;margin-bottom:26px}
.sico{font-family:var(--mono);font-size:9px;color:var(--muted);letter-spacing:.1em;text-transform:uppercase;flex-shrink:0}
.sin{flex:1;background:transparent;border:none;outline:none;font-family:var(--sans);font-size:13px;font-weight:300;color:var(--ink)}
.sin::placeholder{color:var(--muted)}
hr.sep{border:none;border-top:1px solid var(--line);margin:26px 0}
.loading{font-family:var(--mono);font-size:10px;color:var(--muted);letter-spacing:.1em;text-transform:uppercase;padding:32px 0;animation:blink2 1.5s infinite}
.clientcard{border:1px solid var(--line);border-radius:1px;padding:20px;margin-bottom:14px;transition:border-color .15s}
.clientcard:hover{border-color:var(--muted)}
.cc-head{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:10px}
.cc-name{font-family:var(--serif);font-size:20px;font-weight:400;color:var(--black)}
.cc-sector{font-family:var(--mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-top:3px}
.cc-campaign{font-size:12px;color:var(--muted);font-weight:300;margin-bottom:12px}
.cc-axes{display:flex;flex-direction:column;gap:4px}
.cc-axe{font-size:11px;color:var(--muted);font-weight:300;padding:3px 0;border-bottom:1px solid var(--faint)}
.cc-axe:last-child{border-bottom:none}
.cc-status{font-family:var(--mono);font-size:8px;letter-spacing:.1em;text-transform:uppercase;padding:3px 8px;border-radius:1px;border:1px solid rgba(46,110,82,.3);color:var(--green);background:var(--green-pale)}
.modal-overlay{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(10,10,9,.5);z-index:1000;align-items:center;justify-content:center}
.modal-overlay.open{display:flex}
.modal{background:var(--white);border:1px solid var(--line);border-radius:1px;padding:32px;width:520px;max-width:90vw;max-height:85vh;overflow-y:auto}
.modal-title{font-family:var(--serif);font-size:24px;font-weight:300;color:var(--black);margin-bottom:24px}
.modal-close{float:right;font-family:var(--mono);font-size:10px;color:var(--muted);cursor:pointer;letter-spacing:.08em;margin-top:4px}
.modal-close:hover{color:var(--black)}
.modal-foot{display:flex;gap:10px;margin-top:20px}
.sbtn{font-family:var(--mono);font-size:9px;letter-spacing:.14em;text-transform:uppercase;padding:10px 20px;border:1px solid var(--black);background:var(--black);color:var(--white);cursor:pointer;transition:all .18s;border-radius:1px}
.sbtn:hover{background:transparent;color:var(--black)}
.cancelbtn{font-family:var(--mono);font-size:9px;letter-spacing:.14em;text-transform:uppercase;padding:10px 20px;border:1px solid var(--line);color:var(--muted);background:transparent;cursor:pointer;transition:all .18s;border-radius:1px}
.cancelbtn:hover{border-color:var(--muted);color:var(--ink)}
.error-msg{font-family:var(--mono);font-size:10px;color:var(--red);padding:12px 0;letter-spacing:.04em}
</style>
</head>
<body>

<div id="masthead">
  <div class="ml">
    <div class="livew"><div class="ldot"></div>Live</div>
    <div class="ts" id="synct">--</div>
  </div>
  <div class="wordmark">Signal</div>
  <div class="mr">
    <div class="ts">PR Intelligence V2</div>
    <div class="ts" id="source-count">chargement...</div>
  </div>
</div>

<div id="navbar">
  <div class="ntab active" data-p="radar" onclick="go(this)">Radar <span class="nb" id="radar-count">--</span></div>
  <div class="ntab" data-p="mediatek" onclick="go(this)">Mediatek</div>
  <div class="ntab" data-p="bottin" onclick="go(this)">Bottin</div>

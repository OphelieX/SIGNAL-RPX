      <div class="mkitem" data-mk="af"><div class="mkini">DA</div><div><div class="mkn">Debonair Afrik</div><div class="mkm">Pan-Afrique / 180 000 lecteurs / Mode, culture, lifestyle africain</div></div><div class="mkact"><div class="mksig g"></div><button class="mkbtn">Kit PDF</button><button class="mkbtn">Tarifs</button></div></div>
